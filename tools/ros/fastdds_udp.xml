<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS on plain UDPv4 with 4 MiB socket buffers (net.core.rmem_max permitting): the
     default receive buffer (the OS default, ~208 KiB) overflows on the bridge's camera frames
     (~2.4 MB in bursts at 640×480), which RustDDS sends as UDP datagrams. tools/ros/run.sh uses
     this profile unless FASTDDS_DEFAULT_PROFILES_FILE is set. -->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_large_buffers</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="autonomousim_udp" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_large_buffers</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
